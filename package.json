{
  "name": "levil-notes",
  "version": "0.1.3",
  "private": true,
  "author": "levil",
  "description": "A local-first Markdown notes application with native Git workflows.",
  "repository": {
    "type": "git",
    "url": "https://github.com/levil3/SpaceNotes.git"
  },
  "bugs": {
    "url": "https://github.com/levil3/SpaceNotes/issues"
  },
  "homepage": "https://github.com/levil3/SpaceNotes#readme",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1 --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:web": "tsc --noEmit && vite build",
    "build": "npm run build:web && electron-builder --win nsis --publish never",
    "start": "electron .",
    "test": "vitest run src electron macos/bridge"
  },
  "dependencies": {
    "@milkdown/crepe": "7.22.3",
    "chokidar": "3.6.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "electron": "30.5.1",
    "electron-builder": "25.1.8",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "com.levil.notes",
    "productName": "Levil Notes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "afterPack": "scripts/patch-app-icon.cjs",
    "win": {
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
